# .env로 복사해서 사용: cp .env.example .env
# 각 값의 상세 설명과 실측 근거는 .env 파일의 주석 참고.
#
# OSM 데이터는 ODbL 라이선스다. 화면의 "© OpenStreetMap contributors" 표기를 지우지 말 것.

# 구운 지도 팩 (비우면 Overpass 사용). 굽기: npx tsx scripts/bakeMap.ts --help 참고
EXPO_PUBLIC_MAP_PACK_URL=
EXPO_PUBLIC_MAP_PACK_TIMEOUT_MS=8000
EXPO_PUBLIC_USE_OVERPASS_API=true

# 지도 데이터 (OSM · Overpass)
EXPO_PUBLIC_OVERPASS_ENDPOINTS=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass-api.de/api/interpreter
EXPO_PUBLIC_OVERPASS_TIMEOUT_MS=12000
EXPO_PUBLIC_DEFAULT_LAT=37.5266
EXPO_PUBLIC_DEFAULT_LON=126.9244
EXPO_PUBLIC_PLAY_RADIUS_M=1000
EXPO_PUBLIC_USE_OVERPASS=true

# 건물 외곽선 (백그라운드 로드)
EXPO_PUBLIC_FETCH_BUILDINGS=true
EXPO_PUBLIC_BUILDING_TIMEOUT_MS=25000
EXPO_PUBLIC_MAX_BUILDINGS=1500

# 좀비 스폰
EXPO_PUBLIC_ZOMBIES_PER_SQKM=40
EXPO_PUBLIC_MAX_ZOMBIES=120

# 테스트 스폰 모드 (주변에 몇 마리만)
EXPO_PUBLIC_TEST_MODE=true
EXPO_PUBLIC_TEST_ZOMBIE_COUNT=3
EXPO_PUBLIC_TEST_SPAWN_DISTANCE_M=50

# 감지
EXPO_PUBLIC_DETECT_RANGE_MULT=1
EXPO_PUBLIC_DETECT_RANGE_MAX_M=90
EXPO_PUBLIC_USE_FOV=true
EXPO_PUBLIC_DETECT_ALWAYS_M=20
EXPO_PUBLIC_USE_LINE_OF_SIGHT=true
EXPO_PUBLIC_LOS_CORRIDOR_M=8

# 추격
EXPO_PUBLIC_MAX_CHASERS=40
EXPO_PUBLIC_ESCAPE_DISTANCE_M=0
EXPO_PUBLIC_RELENTLESS_CHASE=true

# 좀비 속도 (km/h 직접 지정)
EXPO_PUBLIC_SPEED_CHASE_WALKER=8
EXPO_PUBLIC_SPEED_CHASE_RUNNER=16
EXPO_PUBLIC_SPEED_CHASE_STALKER=12
EXPO_PUBLIC_SPEED_CHASE_BRUTE=10
EXPO_PUBLIC_SPEED_WANDER_WALKER=4
EXPO_PUBLIC_SPEED_WANDER_RUNNER=5
EXPO_PUBLIC_SPEED_WANDER_STALKER=4
EXPO_PUBLIC_SPEED_WANDER_BRUTE=3

# 도로 밖 이동 제한
EXPO_PUBLIC_ROAD_HALF_WIDTH_M=5
EXPO_PUBLIC_CONSTRAIN_TO_ROAD=true

# 전투
EXPO_PUBLIC_GUN_RANGE_M=25
EXPO_PUBLIC_AIM_ANGLE_DEG=8
EXPO_PUBLIC_ATTACK_RANGE_M=0.5
EXPO_PUBLIC_GOD_MODE=true

# AR 화면
EXPO_PUBLIC_AR_MIN_DISTANCE_M=4
EXPO_PUBLIC_AR_SENSOR_SMOOTHING=6
EXPO_PUBLIC_AR_COMPASS_TRUST=0.6
EXPO_PUBLIC_AR_HEADING_DEADBAND_DEG=2
EXPO_PUBLIC_AR_GYRO_YAW_SIGN=-1
EXPO_PUBLIC_AR_ZOMBIE_SMOOTHING=8
EXPO_PUBLIC_AR_LAYER_HEIGHT_M=0
EXPO_PUBLIC_AR_BOB_M=1
EXPO_PUBLIC_AR_KEEP_MS=2000

# 디버그 / 성능
EXPO_PUBLIC_SHOW_RAW_GPS=false
EXPO_PUBLIC_RENDER_INTERVAL_MS=16
EXPO_PUBLIC_RENDER_SMOOTHING=3
