<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap">
  <style>
<!--CSS-->
  </style>
</helmet>

<div style="width: 390px; height: 844px; background: #070A14; overflow: hidden; position: relative; display: flex; flex-direction: column">
  <div style="padding: 62px 22px 0; flex-shrink: 0">
    <div class="eyebrow">2026년 9월 14일 · 구역 C-7</div>
    <div style="color: #fff; font-size: 28px; font-weight: 800; letter-spacing: -0.8px; margin-top: 8px">런 결과</div>
  </div>

  <div style="padding: 18px 22px 0; flex-grow: 1; overflow: hidden">
    <div class="glass" style="border-radius: 22px; padding: 18px">
      <div style="display: flex; flex-direction: row">
        <div style="flex-grow: 1; flex-basis: 0">
          <div class="stat-lbl" style="color: #2FD9FF">주행</div>
          <div style="color: #fff; font-size: 32px; font-weight: 800; letter-spacing: -1px; margin-top: 4px; font-variant-numeric: tabular-nums">2.63<span style="font-size:12px;color:rgba(255,255,255,0.45)">km</span></div>
        </div>
        <div style="flex-grow: 1; flex-basis: 0">
          <div class="stat-lbl">평균 속도</div>
          <div style="color: #fff; font-size: 32px; font-weight: 800; letter-spacing: -1px; margin-top: 4px; font-variant-numeric: tabular-nums">9.8<span style="font-size:12px;color:rgba(255,255,255,0.45)">km/h</span></div>
        </div>
      </div>
      <div style="height: 1px; background: rgba(255,255,255,0.09); margin: 16px 0"></div>
      <div style="display: flex; flex-direction: row">
        <div style="flex-grow: 1; flex-basis: 0"><div class="stat-lbl">생존</div><div style="color:#fff;font-size:19px;font-weight:700;margin-top:3px;font-variant-numeric:tabular-nums">14:22</div></div>
        <div style="flex-grow: 1; flex-basis: 0"><div class="stat-lbl">처치</div><div style="color:#fff;font-size:19px;font-weight:700;margin-top:3px;font-variant-numeric:tabular-nums">09</div></div>
        <div style="flex-grow: 1; flex-basis: 0"><div class="stat-lbl">수거</div><div style="color:#FFC53D;font-size:19px;font-weight:700;margin-top:3px;font-variant-numeric:tabular-nums">3</div></div>
      </div>
    </div>

    <div class="glass" style="border-radius: 20px; padding: 15px 16px; margin-top: 12px">
      <div class="eyebrow" style="margin-bottom: 11px">처치 내역</div>
      <div style="display: flex; flex-direction: column; gap: 9px">
        <div style="display: flex; flex-direction: row; align-items: center; gap: 10px">
          <span style="color: #fff; font-size: 12.5px; font-weight: 700; width: 46px">워커</span>
          <div style="flex-grow: 1; height: 6px; border-radius: 3px; background: rgba(255,255,255,0.09)">
            <div style="width: 56%; height: 6px; border-radius: 3px; background: #2FD9FF"></div>
          </div>
          <span style="color: rgba(255,255,255,0.62); font-size: 12.5px; font-weight: 700; font-variant-numeric: tabular-nums">5</span>
        </div>
        <div style="display: flex; flex-direction: row; align-items: center; gap: 10px">
          <span style="color: #fff; font-size: 12.5px; font-weight: 700; width: 46px">러너</span>
          <div style="flex-grow: 1; height: 6px; border-radius: 3px; background: rgba(255,255,255,0.09)">
            <div style="width: 34%; height: 6px; border-radius: 3px; background: #2FD9FF"></div>
          </div>
          <span style="color: rgba(255,255,255,0.62); font-size: 12.5px; font-weight: 700; font-variant-numeric: tabular-nums">3</span>
        </div>
        <div style="display: flex; flex-direction: row; align-items: center; gap: 10px">
          <span style="color: #fff; font-size: 12.5px; font-weight: 700; width: 46px">스토커</span>
          <div style="flex-grow: 1; height: 6px; border-radius: 3px; background: rgba(255,255,255,0.09)">
            <div style="width: 12%; height: 6px; border-radius: 3px; background: #2FD9FF"></div>
          </div>
          <span style="color: rgba(255,255,255,0.62); font-size: 12.5px; font-weight: 700; font-variant-numeric: tabular-nums">1</span>
        </div>
      </div>
    </div>

    <!-- 배너 광고 자리 -->
    <div style="margin-top: 12px; height: 64px; border-radius: 14px; border: 1px dashed rgba(255,255,255,0.22);
      background: rgba(255,255,255,0.035); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px">
      <div style="color: rgba(255,255,255,0.42); font-size: 11px; font-weight: 700; letter-spacing: 1.4px">배너 광고 320×50</div>
      <div style="color: rgba(255,255,255,0.28); font-size: 10px; font-weight: 600">런이 끝난 뒤에만 노출한다</div>
    </div>
  </div>

  <div style="padding: 0 22px 30px; display: flex; flex-direction: column; gap: 10px; flex-shrink: 0">
    <div style="border-radius: 18px; padding: 15px; background: linear-gradient(180deg, rgba(255,197,61,0.97), rgba(214,152,16,0.97));
      border: 1px solid rgba(255,255,255,0.34); box-shadow: 0 10px 26px rgba(255,197,61,0.26), inset 0 2px 0 rgba(255,255,255,0.4);
      display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 9px">
      <!--ICON:gift--><span style="color: #231A02; font-size: 15.5px; font-weight: 800">광고 보고 보상 2배</span>
    </div>
    <div class="cta">다시 달리기</div>
    <div class="ghost">홈으로</div>
  </div>
</div>
</x-dc>
</body>
</html>
